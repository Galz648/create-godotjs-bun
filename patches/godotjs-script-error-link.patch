+    bool BridgeHelper::find_mapped_ts_frame(const String& p_text, String& r_path, int& r_line, String& r_func)
+    {
+        const Vector<String> lines = p_text.split("\n");
+        for (int li = 0; li < lines.size(); ++li)
+        {
+            const String& line = lines[li];
+            int search = 0;
+            while (search < line.length())
+            {
+                const int res = line.find("res://", search);
+                if (res < 0) break;
+                const int ts = line.find(".ts:", res);
+                if (ts < 0) break;
+
+                bool bad = false;
+                for (int i = res; i < ts; ++i)
+                {
+                    const char32_t c = line[i];
+                    if (c == ' ' || c == '\t' || c == '(' || c == ')')
+                    {
+                        bad = true;
+                        break;
+                    }
+                }
+                if (bad)
+                {
+                    search = res + 6;
+                    continue;
+                }
+
+                // Stack frames are "at func (res://...)" or "at res://...". A path inside the message is not a frame.
+                const int at_pos = line.rfind("at ", res);
+                if (at_pos < 0)
+                {
+                    search = ts + 4;
+                    continue;
+                }
+
+                int num = ts + 4;
+                int line_no = 0;
+                bool any = false;
+                while (num < line.length())
+                {
+                    const char32_t c = line[num];
+                    if (c < '0' || c > '9') break;
+                    any = true;
+                    line_no = line_no * 10 + (int)(c - '0');
+                    if (line_no > 10000000)
+                    {
+                        any = false;
+                        break;
+                    }
+                    ++num;
+                }
+                if (!any || line_no <= 0)
+                {
+                    search = ts + 4;
+                    continue;
+                }
+
+                r_path = line.substr(res, ts + 3 - res);
+                r_line = line_no;
+                r_func = String();
+                if (res > 0 && line[res - 1] == '(')
+                {
+                    int func_end = res - 1;
+                    while (func_end > at_pos + 3 && line[func_end - 1] == ' ') func_end--;
+                    const int func_start = at_pos + 3;
+                    if (func_end > func_start)
+                    {
+                        r_func = line.substr(func_start, func_end - func_start);
+                    }
+                }
+                return true;
+            }
+        }
+        return false;
+    }
 }
