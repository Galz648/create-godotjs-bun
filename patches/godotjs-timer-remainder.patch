+        // A timer must never fire before its due time. Two things make the wheel's clock differ from the real clock:
+        //  - the wheel only turns in whole jiffies: `_time_slice` is the part of the current jiffy already elapsed, so
+        //    the wheel's time is `_elapsed + _time_slice`;
+        //  - the wheel is only fed once per frame (`set_clock` anchors it to the real time of that feed), while scripts
+        //    arm timers at any point inside the frame: that part (`lead`) is already gone when the timer is armed.
+        // A timer armed `lead` ms after the anchor is due `p_delay` ms from now, which is `p_delay + _time_slice + lead`
+        // wheel ms from the wheel's time; round up to a whole jiffy so the wheel fires it on a tick at or after the due
+        // time (late by under one jiffy, never early).
+        jsb_force_inline uint64_t align_delay(uint64_t p_delay) const
+        {
