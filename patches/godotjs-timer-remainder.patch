diff --git a/weaver/jsb_script_language.cpp b/weaver/jsb_script_language.cpp
index 4492111..ad3ec72 100644
--- a/weaver/jsb_script_language.cpp
+++ b/weaver/jsb_script_language.cpp
@@ -134,9 +134,18 @@ void GodotJSScriptLanguage::finish()
 void GodotJSScriptLanguage::frame()
 {
     const uint64_t base_ticks = Engine::get_singleton()->get_frame_ticks();
-    const uint64_t elapsed_milli = (base_ticks - last_ticks_) / 1000ULL; // milliseconds
+    // the first frame starts the clock: last_ticks_ is 0 until then, and feeding (base_ticks - 0) would advance the
+    // timer wheel by the whole engine uptime, so a timer armed in _ready of the first scene would fire at once
+    if (last_ticks_ == 0) last_ticks_ = base_ticks;
+
+    // carry the sub-millisecond remainder: flooring every frame loses ~0.5 ms per frame
+    pending_us_ += base_ticks - last_ticks_;
+    const uint64_t elapsed_milli = pending_us_ / 1000ULL; // milliseconds
+    pending_us_ -= elapsed_milli * 1000ULL;
 
     last_ticks_ = base_ticks;
+    // the wheel is now at base_ticks minus the carried remainder (real time): lets the timer manager arm timers that never fire early
+    environment_->set_timer_anchor(base_ticks - pending_us_);
     environment_->update(elapsed_milli);
 
