+if (typeof g.Event === "undefined") {
+    g.Event = class Event {
+        type: string; defaultPrevented = false; target: any = null; currentTarget: any = null; cancelable: boolean;
+        constructor(type: string, init?: { cancelable?: boolean }) { this.type = String(type); this.cancelable = !!(init && init.cancelable); }
+        preventDefault() { if (this.cancelable) this.defaultPrevented = true; }
+        stopPropagation() { }
