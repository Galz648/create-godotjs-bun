+        if (t - chainStart > 4) {
+            chainStart = -1;
+            nativeSetTimeout(flush, 0);
+        } else {
+            Promise.resolve().then(flush);
+        }
+    };
+    g.setImmediate = (fn: Function, ...args: any[]) => {
+        const item: Item = { fn, args, cancelled: false };
+        queue.push(item);
+        schedule();
+        return item;
+    };
+    g.clearImmediate = (item: any) => { if (item) item.cancelled = true; };
+}
+
+// ---- Error.stack header ----
+// quickjs-ng stacks contain only the "    at ..." frames; Node/V8 (and libraries that print `error.stack`) expect a leading "Name: message" line.
+// Wrap the global Error constructors so errors created from JS get the header. Errors raised by the engine itself are not covered.
+if (!g.__jsbStackHeader) {
+    g.__jsbStackHeader = true;
+    const fix = (e: any) => {
+        try {
+            const st = e.stack;
+            if (typeof st === "string" && !/^[A-Za-z_$][\w$]*(: |\n|$)/.test(st)) {
