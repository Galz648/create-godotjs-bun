+    g.EventTarget = class EventTarget {
+        _listeners: Map<string, { cb: any; once: boolean }[]> = new Map();
+        addEventListener(type: string, cb: any, opts?: any) {
+            if (!cb) return;
+            const once = typeof opts === "object" && opts !== null && !!opts.once;
+            let list = this._listeners.get(type);
+            if (!list) { list = []; this._listeners.set(type, list); }
+            if (list.some((l) => l.cb === cb)) return;
+            list.push({ cb, once });
