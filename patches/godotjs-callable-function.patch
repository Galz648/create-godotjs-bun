+    // Bare function -> free JSCallable (null object id), same construction as
+    // _new_callable for Callable.create(fn). Only the Callable slot and the
+    // untyped Variant overload call this. A plain function declaration is a
+    // constructor in JS, so IsConstructor is not a rejection.
+    static bool js_function_to_callable(v8::Isolate* isolate, const v8::Local<v8::Value>& p_jval, Variant& r_cvar)
+    {
+        if (!p_jval->IsFunction())
+        {
+            return false;
+        }
+        Environment* env = Environment::wrap(isolate);
+        const v8::Local<v8::Function> js_func = p_jval.As<v8::Function>();
+        const ObjectCacheID callback_id = env->get_cached_function(js_func);
+        r_cvar = Callable(memnew(JSCallable(ObjectID(), env->id(), callback_id)));
+        return true;
+    }
